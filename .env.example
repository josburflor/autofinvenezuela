# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime connection variables (injected automatically by AI Studio)
SQL_HOST="/cloudsql/instance-connection-socket"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"

# Cloud SQL PostgreSQL admin variables for Drizzle Kit schema migrations
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Optional SMTP configuration for automatic confirmation emails to clients (can also be configured in Admin Panel)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="Autofin Venezuela · Jesús Artahona"
